# ─────────────────────────────────────────────────────────────
# Euro Glam BD — Environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
# PostgreSQL. The password must be URL-encoded if it contains
# special characters (@ : / ? # [ ] %).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/euro_glam_bd?schema=public"

# ── Auth ───────────────────────────────────────────────────
# MUST be at least 32 bytes of random data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-with-at-least-32-random-bytes"
# 7 days, in seconds (604800)
AUTH_JWT_TTL_SECONDS="604800"

# ── AI Provider ────────────────────────────────────────────
# "mock"       = deterministic offline provider (default, no API key needed)
# "openai"     = real OpenAI calls (requires OPENAI_API_KEY below)
# "gemini"     = real Google Gemini calls (requires GEMINI_API_KEY below)
# "openrouter" = real OpenRouter calls (requires OPENROUTER_API_KEY below)
#
# Whichever provider is chosen, it only *phrases* the advice. The
# candidate list, the ingredient-conflict engine, the allow-list and the
# disclaimer are decided in code and behave identically either way — see
# "Code decides, the model phrases" in DECISIONS.md.
#
# A missing key for the selected provider is a hard failure, not a silent
# fall back to the mock: a staging deployment that looks healthy while
# serving canned advice is worse than one that refuses to start.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
# gemini-3.5-flash is multimodal (so the skin photo can actually be
# looked at), fast enough for a chat turn, and — unlike a `-preview`
# model — it will not be withdrawn without notice.
GEMINI_MODEL="gemini-3.5-flash"

# ── OpenRouter ─────────────────────────────────────────────
# OpenRouter is a *router*: one OpenAI-compatible endpoint in front of
# many upstream model providers. It is the provider to choose when the
# shop wants a rate-limited upstream provider to be routed around
# rather than surfaced to the customer — the provider sends
# `allow_fallbacks: true`, so OpenRouter serves the request from a
# provider that has capacity.
#
# The model id must exist on OpenRouter, and it must be a **MULTIMODAL**
# model. OpenRouter rejects a photo sent to a text-only model with
# "No endpoints found that support image input", so a text-only id
# breaks the advisor's photo analysis outright. Browse the list at
# https://openrouter.ai/models before changing it.
#
# The key needs credit on the account *unless* the model is served on a
# free tier. OpenRouter reserves credit against the model's *maximum*
# context window when a request does not state its own `max_tokens`
# ceiling, and refuses the request with HTTP 402 when the balance cannot
# cover that reservation — a 131072-token context on a small balance
# fails even though the reply itself would be short. This provider always
# states its own ceiling (`MAX_COMPLETION_TOKENS`), so a 402 here means
# the balance is genuinely too small for a paid model. Check it with
# `npm run probe:openrouter:credits`.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash-1017"
# The app title OpenRouter shows on its dashboard. Optional.
OPENROUTER_TITLE="Euro Glam BD"

# ── Storage ────────────────────────────────────────────────
# "local"      = filesystem under UPLOAD_ROOT. The default; needs no
#                credentials and works on a machine with a disk.
# "cloudinary" = Cloudinary. Use this for a serverless deployment (e.g.
#                Vercel), where the filesystem is ephemeral and anything
#                written to it is lost when the instance is recycled.
#
# Either way the database persists a **key** (`products/2026/11/ab12….webp`),
# never a URL, and the public URL is derived from the key at render time.
# Switching drivers is therefore a configuration change rather than a data
# migration — but note that objects already uploaded under the old driver
# keep their old keys and are not moved by the switch.
#
# The driver is chosen once, at startup. An unrecognised value is a hard
# failure rather than a silent fall back, so a typo cannot quietly send
# uploads somewhere nobody is looking.
STORAGE_DRIVER="local"
# ── Cloudinary (only read when STORAGE_DRIVER="cloudinary") ──
# The cloud name from the Cloudinary console's "Product Environment
# Settings" panel — NOT the API secret.
CLOUDINARY_CLOUD_NAME=""
# The API key and secret from the same panel. Both are required; a
# missing credential is a hard failure, not a fall back to the local
# driver.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# ── The public twins of the storage configuration ───────────────────────
#
# `src/lib/format/image.ts` derives the image URL on the **client** as
# well as the server, and Next.js inlines only `NEXT_PUBLIC_*` variables
# into the browser bundle. Without these, the server-rendered pages
# produce Cloudinary URLs while the client components produce
# `/uploads/<key>` — so the admin image picker's previews are blank even
# though the page around them looks correct.
#
# These MUST match `STORAGE_DRIVER` and `CLOUDINARY_CLOUD_NAME` above.
# They carry no secret: the cloud name is already visible in every public
# image URL.
NEXT_PUBLIC_STORAGE_DRIVER="local"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
UPLOAD_ROOT="./public/uploads"
# Public URL prefix for stored objects. The local driver serves files from
# public/uploads, so Next.js serves them at /uploads/<key>. Change this if
# the files are fronted by a CDN instead.
STORAGE_URL_PREFIX="/uploads"
# 5 MB
MAX_IMAGE_BYTES="5242880"
# 50 MB
MAX_VIDEO_BYTES="52428800"

# ── SMS ────────────────────────────────────────────────────
# "mock" = writes to the SmsLog table instead of sending. The default.
#          No credentials, no network, no messages leaving the machine.
# "sslwireless" = the real provider. Requires SSL_WIRELESS_API_KEY below.
#
# An unrecognised value warns and falls back to "mock", so a typo here
# does not take the storefront down. A *missing* credential is a hard
# failure — a deployment that would message real customers must not
# silently deliver nothing while looking healthy.
SMS_GATEWAY="mock"

# Required when SMS_GATEWAY="sslwireless".
# SSL_WIRELESS_API_KEY=""

# The public base URL, used to build the order link in an SMS body.
# Falls back to https://euroglambd.com when unset.
# NEXT_PUBLIC_SITE_URL="https://euroglambd.com"

# ── Email ─────────────────────────────────────────────────
# The SMTP transport used for the sign-in one-time password.
#
# Gmail SMTP is the default, and it is what the deployment guide assumes:
#
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an **App Password** at
#      https://myaccount.google.com/apppasswords
#   3. Put that 16-character app password in EMAIL_PASS below.
#
# A normal Google account password will NOT work. Gmail rejects it, and
# the rejection arrives as an opaque authentication error rather than as
# "wrong password" — which is why the app password is mandatory here.
#
# There is deliberately **no mock driver** for email, unlike the SMS
# gateway above. The email carries the one-time password, and a silently
# dropped email is a sign-in that appears to work and then does not. A
# missing credential is therefore a hard failure: the route returns 503
# and says so.
#
# The `EMAIL_FROM` address must be one the authenticated account is allowed
# to send as (or a configured alias for it), or Gmail will reject the
# message even though the credentials are correct.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Euro Glam BD <noreply@euroglambd.com>"

# ── Content ────────────────────────────────────────────────
# Fallback disclaimer. The authoritative value lives in the AiConfig
# table; this is the hardcoded last-resort fallback if that row is
# missing. Editing this file does NOT change the live disclaimer.
DISCLAIMER_TEXT="This is an aesthetic/skincare suggestion, not a medical prescription from a doctor."

# ── Seed admin (development only) ──────────────────────────
SEED_ADMIN_EMAIL="admin@euroglambd.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Euro Glam Admin"

# ── SSLCOMMERZ ─────────────────────────────────────────────
# The gateway store credentials.
#
# `SSLCOMMERZ_IS_LIVE=false` points every request at
# sandbox.sslcommerz.com. Set it to "true" only when the store has been
# switched to the live gateway — the credentials below are sandbox
# credentials and will not work against a live store.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# ── SSLCOMMERZ: sandbox fallback ───────────────────────────
# Lets a callback settle an order even when the gateway cannot
# vouch for it — the order still moves to PAID / PROCESSING.
#
# It exists because the SSLCOMMERZ sandbox does not always issue a
# validation id for a transaction, so a test order would otherwise sit
# on "we could not confirm the payment yet" forever and the rest of
# the flow could never be exercised.
#
# It is a **test-only** switch, and it is guarded on three fronts.
# All three must hold before a single unverified payment is settled:
#
#   1. This flag is set to "true".
#   2. SSLCOMMERZ_IS_LIVE is **not** "true" — i.e. the shop is in
#      sandbox. A live shop ignores this flag entirely and logs a
#      warning saying so, so a deployment that sets it carelessly
#      still cannot settle a real payment without the gateway's
#      answer.
#   3. The order exists and is still PENDING.
#
# The amount is still checked against the order total, and the
# settlement is still logged loudly — an unverified settlement is not
# a normal event.
#
# Leave this off in production.
SSLCOMMERZ_ALLOW_UNVERIFIED_CALLBACKS="false"
