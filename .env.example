# ─────────────────────────────────────────────────────────────
# Euro Glam BD — Environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
# PostgreSQL. The password must be URL-encoded if it contains
# special characters (@ : / ? # [ ] %).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/euro_glam_bd?schema=public"

# ── Auth ───────────────────────────────────────────────────
# MUST be at least 32 bytes of random data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-with-at-least-32-random-bytes"
# 7 days, in seconds (604800)
AUTH_JWT_TTL_SECONDS="604800"

# ── AI Provider ────────────────────────────────────────────
# "mock"  = deterministic offline provider (default, no API key needed)
# "openai" = real OpenAI calls (requires OPENAI_API_KEY below)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Storage ────────────────────────────────────────────────
# "local" = filesystem under UPLOAD_ROOT
STORAGE_DRIVER="local"
UPLOAD_ROOT="./public/uploads"
# 5 MB
MAX_IMAGE_BYTES="5242880"
# 50 MB
MAX_VIDEO_BYTES="52428800"

# ── SMS ────────────────────────────────────────────────────
# "mock" = writes to the SmsLog table instead of sending
SMS_GATEWAY="mock"

# ── Content ────────────────────────────────────────────────
# Fallback disclaimer. The authoritative value lives in the AiConfig
# table; this is the hardcoded last-resort fallback if that row is
# missing. Editing this file does NOT change the live disclaimer.
DISCLAIMER_TEXT="This is an aesthetic/skincare suggestion, not a medical prescription from a doctor."

# ── Seed admin (development only) ──────────────────────────
SEED_ADMIN_EMAIL="admin@euroglambd.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Euro Glam Admin"
